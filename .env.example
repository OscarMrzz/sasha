# Playwright E2E: cuenta con acceso al panel y al módulo de usuarios.
# Copia este archivo a .env, rellena los valores y no subas .env al repositorio.
# Playwright solo lee .env (no este archivo).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=SUPABASE_SERVICE_ROLE_KEY="sb_secret_…"
NEXT_PUBLIC_SUPABASE_BUCKET_PERFILES=img-fotos-perfiles-aurora
