# Frontend (Next) → Supabase local de ESTE repo (project_id = backend-sasha)
# Tras `npx supabase start`, copia URL y keys con: `npx supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:65321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage (ajusta el bucket si lo creas distinto en Sasha)
NEXT_PUBLIC_SUPABASE_BUCKET_PERFILES=img-fotos-perfiles-sasha

# Playwright E2E
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Puertos locales backend-sasha (no chocan con otro proyecto local en 6432x):
#   API/Studio DB: 65321 / 65323 / 65322
#   Inbucket (mails): 65324
#   Shadow / pooler / analytics: 65320 / 65329 / 65327
